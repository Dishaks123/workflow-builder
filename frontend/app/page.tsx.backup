"use client";

import { useState } from "react";

const WORKFLOW_ID =
  "b5fb1dd1-3cc7-4df1-a2a4-b8e1de110658";






const stepTypes = [
  {
    type: "llm_call",
    label: "LLM Call",
  },
  {
    type: "http_request",
    label: "HTTP Request",
  },
  {
    type: "conditional_branch",
    label: "Conditional Branch",
  },
  {
    type: "approval_gate",
    label: "Approval Gate",
  },
  {
    type: "db_write",
    label: "DB Write",
  },
  {
    type: "notify",
    label: "Notify",
  },
];

export default function Home() {
  const [loggedIn, setLoggedIn] =
    useState(false);

  const [accessToken, setAccessToken] =
    useState("");


  const [userEmail, setUserEmail] =
    useState("");

  const [email, setEmail] =
    useState("");

  const [password, setPassword] =
    useState("");

  const [loginStatus, setLoginStatus] =
    useState("");

  const [status, setStatus] =
    useState("Ready");

  const [runId, setRunId] =
    useState("");

  const [workflowName, setWorkflowName] =
    useState("Milestone 3 Workflow");

  const [selectedSteps, setSelectedSteps] =
    useState<string[]>([
      "llm_call",
      "http_request",
      "conditional_branch",
      "approval_gate",
    ]);

  /*
   * =====================================================
   * LOGIN
   * =====================================================
   */

  async function login() {
    if (!email || !password) {
      setLoginStatus(
        "Enter email and password"
      );
      return;
    }

    setLoginStatus("Logging in...");

    try {
      const response = await fetch(
        "https://local.auth.local.nhost.run/v1/signin/email-password",
        {
          method: "POST",

          headers: {
            "Content-Type":
              "application/json",
          },

          body: JSON.stringify({
            email,
            password,
          }),
        }
      );

      const data =
        await response.json();

      console.log(
        "Login response:",
        data
      );

      if (!response.ok) {
        setLoginStatus(
          data?.message ||
            data?.error ||
            "Login failed"
        );

        return;
      }

      if (!data?.session) {
        setLoginStatus(
          "Login failed: session missing"
        );

        return;
      }

      const token =
        data.session.accessToken;

      if (!token) {
        setLoginStatus(
          "Login failed: access token missing"
        );

        return;
      }

      setAccessToken(token);

      setUserEmail(
        data.session.user?.email ||
          email
      );

      setLoggedIn(true);

      setEmail("");

      setPassword("");

      setLoginStatus("");

      setStatus("Ready");

      console.log(
        "LOGIN SUCCESSFUL"
      );

      console.log(
        "User:",
        data.session.user?.email
      );

      console.log(
        "Access token received:",
        true
      );
    } catch (error: any) {
      console.error(
        "Login error:",
        error
      );

      setLoginStatus(
        error?.message ||
          "Unable to connect to authentication service"
      );
    }
  }

  /*
   * =====================================================
   * LOGOUT
   * =====================================================
   */

  function logout() {
    setLoggedIn(false);

    setAccessToken("");

    setUserEmail("");

    setEmail("");

    setPassword("");

    setLoginStatus("");

    setStatus("Ready");

    setRunId("");
  }

  /*
   * =====================================================
   * RUN WORKFLOW
   * =====================================================
   */

  async function runWorkflow() {
    if (!accessToken) {
      setStatus(
        "Authentication token missing"
      );

      return;
    }

    setRunId("");

    setStatus(
      "Starting workflow..."
    );

    try {
      console.log(
        "Starting workflow"
      );

      console.log(
        "Workflow ID:",
        WORKFLOW_ID
      );

      const response =
        await fetch(
          "/api/run-workflow",
          {
            method: "POST",

            headers: {
              "Content-Type":
                "application/json",

              Authorization:
                `Bearer ${accessToken}`,
            },

            body: JSON.stringify({
              input: {
                workflow_id:
                  WORKFLOW_ID,
              },
            }),
          }
        );

      const data =
        await response.json();

      console.log(
        "Workflow HTTP status:",
        response.status
      );

      console.log(
        "Workflow response:",
        data
      );

      if (!response.ok) {
        setStatus(
          data?.message ||
            data?.error ||
            "Workflow request failed"
        );

        return;
      }

      if (data?.run_id) {
        setRunId(
          data.run_id
        );
      }

      if (
        data?.status ===
        "paused"
      ) {
        setStatus(
          "Paused — awaiting approval"
        );

        return;
      }

      if (
        data?.status ===
        "failed"
      ) {
        setStatus(
          data?.message ||
            "Workflow failed"
        );

        return;
      }

      if (data?.status) {
        setStatus(
          `Workflow ${data.status}`
        );

        return;
      }

      if (data?.success) {
        setStatus(
          data?.message ||
            "Workflow started successfully"
        );

        return;
      }

      setStatus(
        data?.message ||
          "Workflow completed"
      );
    } catch (error: any) {
      console.error(
        "Workflow error:",
        error
      );

      setStatus(
        error?.message ||
          "Unable to connect to workflow service"
      );
    }
  }

  /*
   * =====================================================
   * APPROVE WORKFLOW
   * =====================================================
   */

  async function approveWorkflow() {
    if (!accessToken) {
      setStatus(
        "Authentication token missing"
      );

      return;
    }

    if (!runId) {
      setStatus(
        "Run ID is missing"
      );

      return;
    }

    setStatus(
      "Approving workflow..."
    );

    try {
      console.log(
        "Approving workflow"
      );

      console.log(
        "Run ID:",
        runId
      );

      const response =
        await fetch(
          "/api/approve-workflow",
          {
            method: "POST",

            headers: {
              "Content-Type":
                "application/json",

              Authorization:
                `Bearer ${accessToken}`,
            },

            body: JSON.stringify({
              input: {
                run_id:
                  runId,
              },
            }),
          }
        );

      const data =
        await response.json();

      console.log(
        "Approval HTTP status:",
        response.status
      );

      console.log(
        "Approval response:",
        data
      );

      if (!response.ok) {
        setStatus(
          data?.message ||
            "Approval failed"
        );

        return;
      }

      if (
        data?.status ===
        "completed"
      ) {
        setStatus(
          "Workflow completed"
        );

        return;
      }

      if (data?.success) {
        setStatus(
          data?.message ||
            "Workflow approved"
        );

        return;
      }

      setStatus(
        data?.message ||
          "Workflow approved"
      );
    } catch (error: any) {
      console.error(
        "Approval error:",
        error
      );

      setStatus(
        error?.message ||
          "Approval request failed"
      );
    }
  }

  /*
   * =====================================================
   * ADD STEP
   * =====================================================
   */

  function addStep(type: string) {
    setSelectedSteps([
      ...selectedSteps,
      type,
    ]);
  }

  /*
   * =====================================================
   * REMOVE STEP
   * =====================================================
   */

  function removeStep(index: number) {
    setSelectedSteps(
      selectedSteps.filter(
        (_, i) =>
          i !== index
      )
    );
  }

  /*
   * =====================================================
   * LOGIN SCREEN
   * =====================================================
   */

  if (!loggedIn) {
    return (
      <main
        style={{
          minHeight: "100vh",
          background: "#0f172a",
          color: "white",
          display: "flex",
          alignItems: "center",
          justifyContent: "center",
          fontFamily:
            "Arial, sans-serif",
        }}
      >
        <section
          style={{
            width: "380px",
            background: "#1e293b",
            padding: "30px",
            borderRadius: "12px",
          }}
        >
          <h1>
            AI Agent Workflow Builder
          </h1>

          <p
            style={{
              color: "#94a3b8",
            }}
          >
            Login to continue
          </p>

          <input
            type="email"
            placeholder="Email"
            value={email}
            onChange={(e) =>
              setEmail(
                e.target.value
              )
            }
            style={{
              width: "100%",
              padding: "12px",
              marginTop: "15px",
              boxSizing:
                "border-box",
              background:
                "#0f172a",
              color: "white",
              border:
                "1px solid #475569",
              borderRadius:
                "6px",
            }}
          />

          <input
            type="password"
            placeholder="Password"
            value={password}
            onChange={(e) =>
              setPassword(
                e.target.value
              )
            }
            onKeyDown={(e) => {
              if (
                e.key === "Enter"
              ) {
                login();
              }
            }}
            style={{
              width: "100%",
              padding: "12px",
              marginTop: "12px",
              boxSizing:
                "border-box",
              background:
                "#0f172a",
              color: "white",
              border:
                "1px solid #475569",
              borderRadius:
                "6px",
            }}
          />

          <button
            onClick={login}
            style={{
              width: "100%",
              padding: "13px",
              marginTop: "18px",
              background:
                "#2563eb",
              color: "white",
              border: "none",
              borderRadius:
                "7px",
              cursor:
                "pointer",
              fontWeight:
                "bold",
            }}
          >
            Login
          </button>

          {loginStatus && (
            <p
              style={{
                color: "#ef4444",
                marginTop: "15px",
              }}
            >
              {loginStatus}
            </p>
          )}
        </section>
      </main>
    );
  }

  /*
   * =====================================================
   * WORKFLOW SCREEN
   * =====================================================
   */

  return (
    <main
      style={{
        minHeight: "100vh",
        background: "#0f172a",
        color: "white",
        padding: "30px",
        fontFamily:
          "Arial, sans-serif",
        boxSizing:
          "border-box",
      }}
    >
      <div
        style={{
          display: "flex",
          justifyContent:
            "space-between",
          alignItems: "center",
        }}
      >
        <div>
          <h1>
            AI Agent Workflow Builder
          </h1>

          <p
            style={{
              color: "#94a3b8",
              marginTop: "5px",
            }}
          >
            Build and execute
            AI-powered workflows
          </p>
        </div>

        <div>
          <span
            style={{
              marginRight:
                "15px",
              color:
                "#22c55e",
            }}
          >
            {userEmail}
          </span>

          <button
            onClick={logout}
            style={{
              padding:
                "9px 14px",
              background:
                "#ef4444",
              color:
                "white",
              border:
                "none",
              borderRadius:
                "6px",
              cursor:
                "pointer",
            }}
          >
            Logout
          </button>
        </div>
      </div>

      <div
        style={{
          display: "grid",
          gridTemplateColumns:
            "240px 1fr 280px",
          gap: "20px",
          marginTop: "30px",
        }}
      >
        {/* STEP TYPES */}

        <section
          style={{
            background:
              "#1e293b",
            padding:
              "20px",
            borderRadius:
              "10px",
          }}
        >
          <h2>
            Step Types
          </h2>

          {stepTypes.map(
            (step) => (
              <button
                key={
                  step.type
                }
                onClick={() =>
                  addStep(
                    step.type
                  )
                }
                style={{
                  width: "100%",
                  padding:
                    "12px",
                  marginTop:
                    "10px",
                  background:
                    "#334155",
                  color:
                    "white",
                  border:
                    "none",
                  borderRadius:
                    "6px",
                  cursor:
                    "pointer",
                  textAlign:
                    "left",
                  fontSize:
                    "16px",
                }}
              >
                +{" "}
                {
                  step.label
                }
              </button>
            )
          )}
        </section>

        {/* WORKFLOW */}

        <section
          style={{
            background:
              "#1e293b",
            padding:
              "20px",
            borderRadius:
              "10px",
          }}
        >
          <h2>
            Workflow
          </h2>

          <input
            value={
              workflowName
            }
            onChange={(e) =>
              setWorkflowName(
                e.target.value
              )
            }
            style={{
              width: "100%",
              padding:
                "12px",
              marginBottom:
                "20px",
              background:
                "#0f172a",
              color:
                "white",
              border:
                "1px solid #475569",
              borderRadius:
                "6px",
              boxSizing:
                "border-box",
              fontSize:
                "16px",
            }}
          />

          {selectedSteps.map(
            (
              type,
              index
            ) => {
              const step =
                stepTypes.find(
                  (
                    item
                  ) =>
                    item.type ===
                    type
                );

              return (
                <div
                  key={index}
                  style={{
                    background:
                      "#334155",
                    padding:
                      "15px",
                    marginBottom:
                      "10px",
                    borderRadius:
                      "8px",
                    display:
                      "flex",
                    justifyContent:
                      "space-between",
                    alignItems:
                      "center",
                  }}
                >
                  <div>
                    <strong
                      style={{
                        fontSize:
                          "18px",
                      }}
                    >
                      {index +
                        1}.{" "}
                      {
                        step?.label
                      }
                    </strong>

                    <div
                      style={{
                        fontSize:
                          "12px",
                        color:
                          "#94a3b8",
                        marginTop:
                          "5px",
                      }}
                    >
                      {type}
                    </div>
                  </div>

                  <button
                    onClick={() =>
                      removeStep(
                        index
                      )
                    }
                    style={{
                      background:
                        "#ef4444",
                      color:
                        "white",
                      border:
                        "none",
                      padding:
                        "8px 12px",
                      borderRadius:
                        "5px",
                      cursor:
                        "pointer",
                    }}
                  >
                    Remove
                  </button>
                </div>
              );
            }
          )}
        </section>

        {/* EXECUTION */}

        <section
          style={{
            background:
              "#1e293b",
            padding:
              "20px",
            borderRadius:
              "10px",
          }}
        >
          <h2>
            Execution
          </h2>

          <button
            onClick={
              runWorkflow
            }
            style={{
              width: "100%",
              padding:
                "14px",
              background:
                "#2563eb",
              color:
                "white",
              border:
                "none",
              borderRadius:
                "7px",
              cursor:
                "pointer",
              fontSize:
                "16px",
              fontWeight:
                "bold",
            }}
          >
            ▶ Run Workflow
          </button>

          {/* STATUS */}

          <div
            style={{
              marginTop:
                "20px",
              padding:
                "15px",
              background:
                "#0f172a",
              borderRadius:
                "7px",
            }}
          >
            <strong>
              Status
            </strong>

            <p
              style={{
                color:
                  status
                    .toLowerCase()
                    .includes(
                      "failed"
                    ) ||
                  status
                    .toLowerCase()
                    .includes(
                      "unable"
                    ) ||
                  status
                    .toLowerCase()
                    .includes(
                      "required"
                    ) ||
                  status
                    .toLowerCase()
                    .includes(
                      "authentication"
                    ) ||
                  status
                    .toLowerCase()
                    .includes(
                      "error"
                    )
                    ? "#ef4444"
                    : "#22c55e",
              }}
            >
              {status}
            </p>
          </div>

          {/* APPROVE BUTTON */}

          {status ===
            "Paused — awaiting approval" &&
            runId && (
              <button
                onClick={
                  approveWorkflow
                }
                style={{
                  width: "100%",
                  marginTop:
                    "15px",
                  padding:
                    "14px",
                  background:
                    "#16a34a",
                  color:
                    "white",
                  border:
                    "none",
                  borderRadius:
                    "7px",
                  cursor:
                    "pointer",
                  fontSize:
                    "16px",
                  fontWeight:
                    "bold",
                }}
              >
                ✓ Approve Workflow
              </button>
            )}

          {/* RUN ID */}

          {runId && (
            <div
              style={{
                marginTop:
                  "15px",
                padding:
                  "15px",
                background:
                  "#0f172a",
                borderRadius:
                  "7px",
                fontSize:
                  "12px",
                wordBreak:
                  "break-all",
              }}
            >
              <strong>
                Run ID
              </strong>

              <p
                style={{
                  color:
                    "#94a3b8",
                }}
              >
                {runId}
              </p>
            </div>
          )}

          {/* QUOTA */}

          <div
            style={{
              marginTop:
                "20px",
              padding:
                "15px",
              background:
                "#0f172a",
              borderRadius:
                "7px",
            }}
          >
            <strong>
              Usage / Quota
            </strong>

            <p>
              1 / 100 calls used
            </p>
          </div>
        </section>
      </div>
    </main>
  );
}
